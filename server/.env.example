# ---------------------------------------------------------------------------
# Wedding Photo Finder — server AI configuration
#
# Copy this file to  server/.env  and fill in your key.
# server/.env is gitignored and is read ONLY by the backend proxy.
# The key is NEVER sent to the browser / bundled into frontend code.
# ---------------------------------------------------------------------------

# Required to enable AI search. Without it, the app runs but AI search is
# cleanly disabled (no fake results).
AI_API_KEY=

# Optional. Defaults to OpenAI. Point this at any OpenAI-compatible vision
# endpoint (Azure OpenAI, a local gateway, etc.).
# AI_BASE_URL=https://api.openai.com/v1

# Optional. Must be a vision-capable model. Default: gpt-4o-mini
# AI_MODEL=gpt-4o-mini

# Optional. Port for the proxy (frontend dev server proxies /api here).
# PORT=8787
